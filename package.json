{
    "name": "@illinois-toolkit/ilw-modal",
    "description": "Illinois Toolkit: provides a modal that opens on top of a web page.",
    "repository": "github:web-illinois/ilw-modal",
    "private": false,
    "license": "MIT",
    "version": "1.0.2",
    "type": "module",
    "files": [
        "src/**",
        "dist/**",
        "builder/**"
    ],
    "exports": {
        ".": {
            "import": "./dist/ilw-modal.js",
            "require": "./dist/ilw-modal.cjs",
            "default": "./dist/ilw-modal.js"
        },
        "./ilw-modal.css": {
            "import": "./dist/ilw-modal.css"
        }
    },
    "main": "./dist/ilw-modal.js",
    "module": "./dist/ilw-modal.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build --config vite.transpile.config.ts --emptyOutDir && vite build --config vite.build.config.ts --emptyOutDir",
        "preview": "vite preview",
        "prepack": "npm run build"
    },
    "dependencies": {
        "lit": "3.1.3"
    },
    "devDependencies": {
        "typescript": "^5.9.2",
        "vite": "^7.1.7",
        "vite-plugin-dts": "^4.5.4"
    }
}
